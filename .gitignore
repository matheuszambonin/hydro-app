cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Ambiente virtual
venv/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema
.DS_Store
Thumbs.db

# Projeto
output/
results/
*.log
.streamlit/secrets.toml
instance/

# PyInstaller
dist/
build/
*.spec

# Dados de teste
test_data/
*.csv~
EOF

git add .gitignore
git commit -m "chore: adiciona .gitignore robusto"
git push.coverage
*.coverage
htmlcov/
